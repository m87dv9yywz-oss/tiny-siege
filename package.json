{
  "name": "tiny-siege",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/game.test.js tests/progression.test.js tests/polish.test.js",
    "test:browser": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-tiny-siege \"node --test tests/firebase.test.js\"",
    "test:cloud": "firebase emulators:exec --only firestore,auth --project demo-tiny-siege \"node --test tests/firebase.test.js tests/auth-emulator.test.js && playwright test tests/browser/cloud.spec.js --output=test-results/cloud\""
  },
  "dependencies": {
    "firebase": "13.0.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.0",
    "firebase-tools": "15.33.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
