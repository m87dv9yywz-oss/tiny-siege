rules_version = '2';
// Parent-owned profiles: users/{uid}/profiles/{profileId}, schema 1.
// No parent document, nested collection, public read or user-assigned role.
// nickname: 1..32 characters; avatar: predefined fantasy ID; crowns: bounded int.
// towerXP: exactly five {earned,spent} maps; unlockedUpgrades: five 3-tier lists.
// completedMaps/mapStars/achievements: fixed known IDs; settings: two booleans.
// statistics: bounded counters/revision and bounded delimiter-encoded reward IDs.
// updatedAt must be a server timestamp on every create AND update.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function number(n) { return n is int && n >= 0 && n <= 1000000000; }
    function xp(x) {
      let earned=x.earned;
      let spent=x.spent;
      return x is map && x.keys().hasOnly(['earned','spent'])
        && earned is int && spent is int && spent >= 0 && spent <= earned && earned <= 1000000000;
    }
    function paths(x) {
      let a=x[0]; let b=x[1]; let c=x[2];
      return x is list && x.size() == 3 && a is int && b is int && c is int
        && a >= 1 && a <= 3 && b >= 1 && b <= 3 && c >= 1 && c <= 3;
    }
    function five(m) { return m is map && m.size() == 5 && m.keys().hasOnly(['archer','cannon','frost','fire','lightning']); }
    function stars(m) {
      let e=m.get('emerald',0); let a=m.get('amber',0); let moon=m.get('moon',0);
      return m is map && m.keys().hasOnly(['emerald','amber','moon'])
        && e is int && e >= 0 && e <= 3 && a is int && a >= 0 && a <= 3
        && moon is int && moon >= 0 && moon <= 3;
    }
    function stats(s) {
      let r=s.revision; let w=s.wins; let waves=s.waves;
      let d=s.damage; let a=s.armor; let k=s.kills; let ledger=s.ledger;
      return s is map && s.size() == 7 && s.keys().hasOnly(['revision','ledger','wins','waves','damage','armor','kills'])
        && r is int && r >= 0 && r <= 1000000000
        && w is int && w >= 0 && w <= 1000000000
        && waves is int && waves >= 0 && waves <= 1000000000
        && d is int && d >= 0 && d <= 1000000000
        && a is int && a >= 0 && a <= 1000000000
        && k is int && k >= 0 && k <= 1000000000
        && ledger is string && ledger.size() <= 194000 && ledger.matches('^(\\|[a-zA-Z0-9_-]{1,96})*\\|?$');
    }
    function validProfile() {
      let d=request.resource.data;
      let fields=['schemaVersion','nickname','avatar','crowns','towerXP','unlockedTowers','unlockedUpgrades','completedMaps','mapStars','achievements','statistics','settings','updatedAt'];
      // Allowed keys + exact size are equivalent to requiring every field.
      // Cache nested maps to stay within Firestore's 1000-expression budget.
      let x=d.towerXP;
      let u=d.unlockedUpgrades;
      let towers=d.unlockedTowers;
      let maps=d.completedMaps;
      let mapStars=d.mapStars;
      let achievements=d.achievements;
      let statistics=d.statistics;
      let settings=d.settings;
      return d.size() == 13 && d.keys().hasOnly(fields)
        && d.schemaVersion == 1 && d.schemaVersion is int
        && d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 32
        && d.avatar in ['dragon','castle','fox','owl','wizard','unicorn']
        && number(d.crowns)
        && five(x) && xp(x.archer) && xp(x.cannon) && xp(x.frost) && xp(x.fire) && xp(x.lightning)
        && five(u) && paths(u.archer) && paths(u.cannon) && paths(u.frost) && paths(u.fire) && paths(u.lightning)
        && towers is list && towers.size() <= 5 && towers.hasAll(['archer','cannon','frost']) && towers.hasOnly(['archer','cannon','frost','fire','lightning']) && towers.toSet().size() == towers.size()
        && maps is list && maps.size() <= 3 && maps.hasOnly(['emerald','amber','moon']) && maps.toSet().size() == maps.size()
        && stars(mapStars) && mapStars.keys().hasOnly(maps)
        && achievements is list && achievements.size() <= 3 && achievements.hasOnly(['first-clear','three-kingdoms','evolution']) && achievements.toSet().size() == achievements.size()
        && stats(statistics)
        && settings is map && settings.size() == 2 && settings.keys().hasOnly(['sound','reducedEffects']) && settings.sound is bool && settings.reducedEffects is bool
        && d.updatedAt is timestamp && d.updatedAt == request.time;
    }
    match /users/{uid}/profiles/{profileId} {
      allow get, list: if owner(uid);
      // One write clause avoids duplicate validation for unconstrained set writes.
      // Delete remains a separate owner-only permission. Both creates and updates
      // still run the complete validator with exactly the same field constraints.
      allow write: if owner(uid) && request.method in ['create','update'] && profileId.matches('^[a-zA-Z0-9_-]{1,64}$') && validProfile();
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
