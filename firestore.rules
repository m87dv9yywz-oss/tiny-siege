rules_version = '2';
// Parent-owned profiles: users/{uid}/profiles/{profileId}, schema 1.
// No parent document, nested collection, public read or user-assigned role.
// nickname: 1..32 characters; avatar: predefined fantasy ID; crowns: bounded int.
// towerXP: exactly five {earned,spent} maps; unlockedUpgrades: five 3-tier lists.
// completedMaps/mapStars/achievements: fixed known IDs; settings: two booleans.
// statistics: bounded counters/revision and bounded delimiter-encoded reward IDs.
// updatedAt must be a server timestamp on every create AND update.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function number(n) { return n is int && n >= 0 && n <= 1000000000; }
    function xpPair(earned,spent) {
      return earned is int && spent is int && spent >= 0 && spent <= earned && earned <= 1000000000;
    }
    function xp(x) { return x is map && x.size() == 2 && x.keys().hasOnly(['earned','spent']) && xpPair(x.earned,x.spent); }
    function tier(n) { return n is int && n >= 1 && n <= 3; }
    function paths(x) { return x is list && x.size() == 3 && tier(x[0]) && tier(x[1]) && tier(x[2]); }
    function five(m) { return m is map && m.size() == 5 && m.keys().hasOnly(['archer','cannon','frost','fire','lightning']); }
    function star(n) { return n is int && n >= 0 && n <= 3; }
    function stars(m) { return m is map && m.keys().hasOnly(['emerald','amber','moon']) && (!('emerald' in m) || star(m.emerald)) && (!('amber' in m) || star(m.amber)) && (!('moon' in m) || star(m.moon)); }
    function stats(s) { return s is map && s.size() == 7 && s.keys().hasOnly(['revision','ledger','wins','waves','damage','armor','kills']) && number(s.revision) && number(s.wins) && number(s.waves) && number(s.damage) && number(s.armor) && number(s.kills) && s.ledger is string && s.ledger.size() <= 194000 && s.ledger.matches('^(\\|[a-zA-Z0-9_-]{1,96})*\\|?$'); }
    function validProfile(d) {
      return d.size() == 13 && d.keys().hasOnly(['schemaVersion','nickname','avatar','crowns','towerXP','unlockedTowers','unlockedUpgrades','completedMaps','mapStars','achievements','statistics','settings','updatedAt'])
        && d.schemaVersion == 1 && d.schemaVersion is int
        && d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 32
        && d.avatar in ['dragon','castle','fox','owl','wizard','unicorn']
        && number(d.crowns)
        && five(d.towerXP) && xp(d.towerXP.archer) && xp(d.towerXP.cannon) && xp(d.towerXP.frost) && xp(d.towerXP.fire) && xp(d.towerXP.lightning)
        && five(d.unlockedUpgrades) && paths(d.unlockedUpgrades.archer) && paths(d.unlockedUpgrades.cannon) && paths(d.unlockedUpgrades.frost) && paths(d.unlockedUpgrades.fire) && paths(d.unlockedUpgrades.lightning)
        && d.unlockedTowers is list && d.unlockedTowers.size() <= 5 && d.unlockedTowers.hasAll(['archer','cannon','frost']) && d.unlockedTowers.hasOnly(['archer','cannon','frost','fire','lightning']) && d.unlockedTowers.toSet().size() == d.unlockedTowers.size()
        && d.completedMaps is list && d.completedMaps.size() <= 3 && d.completedMaps.hasOnly(['emerald','amber','moon']) && d.completedMaps.toSet().size() == d.completedMaps.size()
        && stars(d.mapStars) && d.mapStars.keys().hasOnly(d.completedMaps)
        && d.achievements is list && d.achievements.size() <= 3 && d.achievements.hasOnly(['first-clear','three-kingdoms','evolution']) && d.achievements.toSet().size() == d.achievements.size()
        && stats(d.statistics)
        && d.settings is map && d.settings.size() == 2 && d.settings.keys().hasOnly(['sound','reducedEffects']) && d.settings.sound is bool && d.settings.reducedEffects is bool
        && d.updatedAt is timestamp && d.updatedAt == request.time;
    }
    match /users/{uid}/profiles/{profileId} {
      allow get, list: if owner(uid);
      // One write clause avoids duplicate validation for unconstrained set writes.
      // Delete remains a separate owner-only permission. Both creates and updates
      // still run the complete validator with exactly the same field constraints.
      allow write: if owner(uid) && request.method in ['create','update'] && profileId.matches('^[a-zA-Z0-9_-]{1,64}$') && validProfile(request.resource.data);
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
